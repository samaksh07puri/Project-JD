# Frontend environment variables.
# Copy to `.env.local` and point it at your backend.

# Public base URL of the FastAPI backend.
# Local dev:  http://localhost:8000
#
# On Vercel "services" (frontend + backend in one project, see the root
# vercel.json) LEAVE THIS UNSET. The frontend then calls the API through the
# same origin (/api/...) and Vercel routes those requests to the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
