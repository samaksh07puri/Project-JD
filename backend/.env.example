# Backend environment variables.
# Copy this file to `.env` and fill in your keys. Never commit `.env`.
#
# Optional: encrypt your secrets at rest. Any value below that is prefixed with
# "enc:" is transparently decrypted on startup using SECRET_ENCRYPTION_KEY.
#   python scripts/manage_secrets.py keygen        # generate a master key
#   python scripts/manage_secrets.py encrypt-env   # encrypt .env in place
# Keep SECRET_ENCRYPTION_KEY private; it is the only value that can decrypt them.

# Master key for decrypting "enc:"-prefixed settings. Leave empty if unused.
# Prefer setting this in the real environment (setx / export / platform secret
# store) rather than writing the plaintext key into .env.
SECRET_ENCRYPTION_KEY=

# Which LLM provider to use: gemini | openai | groq
LLM_PROVIDER=gemini

# Model name for the selected provider.
#   gemini -> gemini-3.5-flash-lite  (free tier, reliable default)
#             gemini-3.8-flash       (optional, occasionally rate-limited)
#   openai -> gpt-4o-mini       (or gpt-4o)
#   groq   -> llama-3.3-70b-versatile (or mixtral-8x7b-32768)
LLM_MODEL=gemini-3.5-flash-lite

# API keys (only the one matching LLM_PROVIDER is required)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional: override the OpenAI-compatible base URL (advanced)
OPENAI_BASE_URL=https://api.openai.com/v1

# Server / upload limits
MAX_UPLOAD_MB=5
REQUEST_TIMEOUT=120

# Comma separated list of allowed CORS origins, or * for all.
ALLOWED_ORIGINS=*

# Auth & persistence
# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime in minutes (default 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Database connection string. Defaults to a local SQLite file.
# For production persistence use a Postgres DSN (Render/Neon/Supabase):
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./resume_aid.db

# Password reset
# Public URL of the frontend, used to build the emailed reset link.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_EXPIRE_MINUTES=30

# SMTP (optional)
# Leave SMTP_HOST empty to skip real email; the reset link is then printed to
# the backend console (and returned to the UI in dev) so you can still test.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
