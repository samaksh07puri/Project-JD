# Root .gitignore

# Environment files (never commit real keys)
.env
.env.*
!.env.example
!*.env.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js
node_modules/
.next/
out/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
